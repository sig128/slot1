# SLOT1 environment. Copy to .env and fill in. Never commit real values.
# Every optional integration can be left blank: SLOT1 keeps running and shows the exact missing
# requirement in the UI instead of substituting demo output.

# ---------------------------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
# The ONE public origin users visit. The web app proxies /api/* to the API on this origin.
SLOT1_PUBLIC_ORIGIN=http://localhost:3000
SLOT1_API_PORT=4000
SLOT1_API_HOST=127.0.0.1
# Internal URL the Next.js server uses for SSR and the /api rewrite.
SLOT1_API_INTERNAL_URL=http://127.0.0.1:4000
# Set true when running behind a reverse proxy (Caddy/nginx) that sets X-Forwarded-*.
SLOT1_TRUST_PROXY=false

# PostgreSQL and Redis. `pnpm services:up` (Docker) uses the defaults below;
# `pnpm services:local` (no Docker) uses ports 5433/6380.
DATABASE_URL=postgres://slot1:slot1@127.0.0.1:5432/slot1
REDIS_URL=redis://127.0.0.1:6379

# 32+ random characters. Signs media URLs. Required in production.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SLOT1_SESSION_SECRET=
# AES-256-GCM key ring for OAuth tokens at rest: comma-separated <id>:<base64 of 32 bytes>.
# The FIRST key encrypts; all keys decrypt (rotate by prepending a new key). Required for Twitch.
#   node -e "console.log('k1:'+require('crypto').randomBytes(32).toString('base64'))"
SLOT1_TOKEN_ENCRYPTION_KEYS=

# Development only: lets you create a local creator account (no Twitch) to upload replays.
# Ignored when NODE_ENV=production.
SLOT1_ALLOW_LOCAL_LOGIN=true

# ---------------------------------------------------------------------------------------------
# Storage — "fs" (local disk) or "s3" (S3-compatible, e.g. MinIO)
# ---------------------------------------------------------------------------------------------
STORAGE_DRIVER=fs
STORAGE_FS_ROOT=.data/storage
S3_ENDPOINT=http://127.0.0.1:9000
# Hostname browsers use to reach object storage for presigned URLs (if different).
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=slot1-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# Lifetime of signed media URLs handed to browsers.
MEDIA_URL_TTL_SECONDS=300

# Upload limits
UPLOAD_MAX_BYTES=1073741824
UPLOAD_MAX_DURATION_SEC=10800
UPLOAD_TMP_DIR=.data/uploads

# ---------------------------------------------------------------------------------------------
# Twitch (https://dev.twitch.tv/console/apps) — see README "Twitch app registration"
# ---------------------------------------------------------------------------------------------
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Must EXACTLY match an OAuth Redirect URL registered on your Twitch app.
TWITCH_REDIRECT_URI=http://localhost:3000/api/auth/twitch/callback
# Public HTTPS URL on port 443 that Twitch can reach (a tunnel works in development).
TWITCH_EVENTSUB_CALLBACK_URL=
# 10–100 ASCII characters, random. Used to verify EventSub signatures.
TWITCH_EVENTSUB_SECRET=
# Every hostname that embeds the Twitch player (local, preview, production), comma-separated.
TWITCH_EMBED_PARENTS=localhost
# Login of the dedicated SLOT1 bot Twitch account. Only this account can be linked as the bot.
SLOT1_BOT_TWITCH_LOGIN=
# Twitch logins that are SLOT1 operators (comma-separated): they can open /admin and link the bot account.
SLOT1_OPERATOR_TWITCH_LOGINS=
# Extra hostnames allowed for Get Clips Download URLs (defaults cover twitch.tv/twitchcdn.net/ttvnw.net/jtvnw.net).
TWITCH_CLIP_DOWNLOAD_HOSTS=

# ---------------------------------------------------------------------------------------------
# AI providers — vision is a real image-input model behind a typed adapter
# ---------------------------------------------------------------------------------------------
# none | anthropic | openai
VISION_PROVIDER=none
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
# Check https://platform.claude.com/docs/en/models/overview for current model IDs.
ANTHROPIC_VISION_MODEL=claude-sonnet-5-5
# Text model for evidence-grounded answers (defaults to the vision model when blank).
ANTHROPIC_TEXT_MODEL=claude-haiku-5-5
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_VISION_MODEL=
OPENAI_TEXT_MODEL=
# Optional: your provider's prices (USD per million tokens) to estimate spend in Studio.
VISION_PRICE_INPUT_PER_MTOK=
VISION_PRICE_OUTPUT_PER_MTOK=
# Frames per vision request and max edge length of frames sent to the model.
VISION_FRAMES_PER_CALL=4
VISION_MAX_EDGE_PX=1280

# Audio transcription: none | openai_compatible (OpenAI or a local server with the same API)
TRANSCRIPTION_PROVIDER=none
TRANSCRIPTION_BASE_URL=https://api.openai.com/v1
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=
TRANSCRIPTION_PRICE_PER_MINUTE=

# Local, deterministic OCR via tesseract: auto | true | false
OCR_ENABLED=auto
TESSERACT_PATH=tesseract
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
FFMPEG_TIMEOUT_SEC=1800

# ---------------------------------------------------------------------------------------------
# Continuous live ingest (a SEPARATE, creator-established relay — a stock PS5 cannot send here)
# ---------------------------------------------------------------------------------------------
# none | nginx-rtmp | mediamtx
INGEST_GATEWAY=none
# Server URL shown to creators (OBS "Server").
INGEST_PUBLIC_RTMP_URL=rtmp://localhost:1935/live
# How the worker reads a stream. Placeholders: {path} {name} {user} {password}
#   nginx-rtmp: rtmp://127.0.0.1:1935/{path}?reader={password}
#   mediamtx:   rtsp://{user}:{password}@127.0.0.1:8554/{path}
INGEST_READ_URL_TEMPLATE=
INGEST_READ_USER=slot1-worker
# Required for both gateways: only the SLOT1 worker may read a creator's stream.
INGEST_READ_PASSWORD=
# Shared secret the gateway passes to /api/ingest/hooks/* (as ?hook_secret=...).
INGEST_HOOK_SECRET=
# SLOT1-hosted live video with sub-second delay (WebRTC). MediaMTX only: nginx-rtmp can't serve
# WebRTC. Browser-facing base of MediaMTX's WebRTC server (WHEP playback, WHIP publishing from OBS).
# Use HTTPS in production, e.g. https://live.example.com; locally http://localhost:8889.
INGEST_PUBLIC_WEBRTC_URL=
# Optional SRT address shown to creators, e.g. srt://live.example.com:8890
INGEST_PUBLIC_SRT_URL=
INGEST_SEGMENT_DIR=.data/ingest-buffer

# ---------------------------------------------------------------------------------------------
# Forwarding ("relay"): SLOT1 passes a creator's ingest stream on to Twitch, YouTube, Kick or a
# custom RTMP(S) server, copy-only. Available whenever continuous ingest is. See docs/RELAY.md.
# ---------------------------------------------------------------------------------------------
# Twitch ingest SLOT1 forwards to (the creator's key comes from Twitch's Get Stream Key).
RELAY_TWITCH_INGEST_URL=rtmps://ingest.global-contribute.live-video.net/app
# Prefilled in the YouTube form: YouTube's secure (RTMPS) primary ingest.
RELAY_YOUTUBE_INGEST_URL=rtmps://a.rtmps.youtube.com:443/live2
# Most destinations one creator may add.
RELAY_MAX_DESTINATIONS=4
# Custom servers must be on the public internet. true only for local tests with a private server.
RELAY_ALLOW_PRIVATE_DESTINATIONS=false

# ---------------------------------------------------------------------------------------------
# Worker & bot
# ---------------------------------------------------------------------------------------------
WORKER_MEDIA_CONCURRENCY=1
WORKER_LIVE_MAX_SOURCES=4
# Global bot kill switch (all channels).
BOT_GLOBAL_KILL=false
BOT_GLOBAL_MESSAGES_PER_30S=60

# ---------------------------------------------------------------------------------------------
# Scaling: shared GTA-model inference service and hardware video decoding (docs/SCALING.md)
# ---------------------------------------------------------------------------------------------
# When set, workers send frames to the shared inference service instead of loading the model
# themselves (one model per GPU for all streams). Leave blank to run the model in each worker.
INFERENCE_URL=
# Required by the service on every request (16+ random characters); workers send the same value.
INFERENCE_SHARED_SECRET=
# A live frame waits at most this long for the service; then it is skipped and counted as dropped.
# Workers send it as the frame's deadline: a service that can't answer within half of it refuses
# the frame at once (429 "busy") rather than answering after the worker stopped waiting.
INFERENCE_TIMEOUT_MS=1500
# Service side: bind address/port, dynamic batching and backpressure.
INFERENCE_HOST=127.0.0.1
INFERENCE_PORT=4100
INFERENCE_MAX_BATCH=16
INFERENCE_MAX_WAIT_MS=8
INFERENCE_MAX_QUEUE=512
# Per stream, at most this many frames wait; a faster stream replaces its own oldest frame.
INFERENCE_MAX_PER_STREAM=4
# Batches running at once (keep 1 per GPU).
INFERENCE_CONCURRENCY=1
# ONNX Runtime providers in order, e.g. cuda,cpu (CUDA needs the inference-gpu image).
INFERENCE_EXECUTION_PROVIDERS=cpu
INFERENCE_MODEL_POLL_MS=15000
# Hardware decoding of live streams: none | cuda | vaapi | videotoolbox (+ optional device).
FFMPEG_HWACCEL=none
FFMPEG_HWACCEL_DEVICE=

# ---------------------------------------------------------------------------------------------
# Demo broadcast (docs/DEMO.md): a public demo channel fed by SLOT1's own synthetic test video,
# analyzed by the real pipeline. On the server: `slot1 demo on` / `slot1 demo off`.
# ---------------------------------------------------------------------------------------------
SLOT1_DEMO=false
# Publishing key of the demo generator (16+ letters/digits; the server script generates one).
SLOT1_DEMO_STREAM_KEY=
# Also send demo frames to the paid AI vision provider (capped at 12 calls an hour). Off: OCR only.
SLOT1_DEMO_VISION=false
# How often the worker samples the demo stream (ms).
SLOT1_DEMO_SAMPLE_MS=3000
# Generator settings. 1280x720 at 30 fps uses about 40% of one CPU core; 960x540 or 24 fps less.
SLOT1_DEMO_VIDEO_SIZE=1280x720
SLOT1_DEMO_FPS=30
SLOT1_DEMO_BITRATE_KBPS=2500
SLOT1_DEMO_PRESET=veryfast

# ---------------------------------------------------------------------------------------------
# Admin dashboard (/admin), visitor counting and the contact page — docs/ADMIN.md
# ---------------------------------------------------------------------------------------------
# Cookieless visitor counting for /admin (no IP or User-Agent stored; DNT/GPC respected). false = off.
SLOT1_ANALYTICS=true
# Shown in /admin → System. The server script can set it to the deployed commit.
SLOT1_VERSION=
# Optional public email shown on /contact next to the form (read at request time; no rebuild).
SLOT1_CONTACT_EMAIL=

# ---------------------------------------------------------------------------------------------
# Legal pages and SEO (docs/LEGAL_AND_SEO.md). All optional, read by the web server on each
# request (no rebuild). On the server: `slot1 legal` and `slot1 seo`.
# ---------------------------------------------------------------------------------------------
# Business or legal name shown as the operator on /privacy and /terms (default: SLOT1).
SLOT1_LEGAL_NAME=
# Registered address, one line.
SLOT1_LEGAL_ADDRESS=
# Country whose law governs the Terms, e.g. Norway. Blank: neutral wording.
SLOT1_GOVERNING_LAW=
# Search-engine verification codes (the content="..." value of their meta tag).
SLOT1_GOOGLE_SITE_VERIFICATION=
SLOT1_BING_SITE_VERIFICATION=
