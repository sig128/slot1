# Public edge for SLOT1: one origin, automatic HTTPS. Set SLOT1_DOMAIN (e.g. slot1.example.com).

# www.<domain> sends visitors to the one canonical address (needs a www DNS record too).
www.{$SLOT1_DOMAIN:localhost} {
	redir https://{$SLOT1_DOMAIN:localhost}{uri} permanent
}

{$SLOT1_DOMAIN:localhost} {
	# Compress documents and JSON, never the live event stream (text/event-stream).
	encode {
		gzip
		match {
			header Content-Type text/html*
			header Content-Type text/css*
			header Content-Type application/javascript*
			header Content-Type application/json*
			header Content-Type image/svg+xml*
		}
	}

	# Ingest gateway hooks are private: only the gateway on the internal network may call them.
	@hooks path /api/ingest/hooks/*
	respond @hooks 404

	# MediaMTX WebRTC over HTTPS: browsers watch with WHEP and OBS can publish with WHIP at
	# https://<domain>/live/<name>/whep|whip. Only answers when the mediamtx gateway is running.
	handle /live/* {
		reverse_proxy mediamtx:8889
	}

	handle /api/* {
		reverse_proxy api:4000 {
			# Server-sent events must reach the browser immediately.
			flush_interval -1
		}
	}

	handle {
		reverse_proxy web:3000
	}
}
